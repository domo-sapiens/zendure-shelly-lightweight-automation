{
  "shelly": {
    "host": "192.168.0.XX",
    "hostname": "Shelly",
    "password": "",
    "scriptName": "zendure-zero-feedin"
  },

  "zendure": {
    "host": "192.168.0.YY",
    "hostname": "zendure",
    "maxOutputW": 800,
    "minOutputW": 0
  },

  "meter": {
    "profile": "triphase",
    "importPositive": true
  },

  "control": {
    "intervalMs": 5000,
    "targetGridW": 0,
    "gain": 0.8,
    "deadbandW": 5,
    "maxStepW": 200,
    "minWriteDeltaW": 3,
    "basis": "actual",
    "busyTimeoutCycles": 3,
    "healthEveryCycles": 120
  },

  "inverter": {
    "overheadW": 22.4,
    "slope": 1.05,
    "_note": "measured 2026-08-13: P_dc = 1.05*P_ac + 22.4W over 2006 solar-free steady-state samples"
  },

  "solar": {
    "passthroughWhenBlocked": true,
    "derate": 0.824,
    "marginW": 2,
    "adaptive": true,
    "targetBatteryW": 8,
    "batteryDeadbandW": 12,
    "adaptGain": 0.35,
    "derateMin": 0.30,
    "derateMax": 1.0,
    "_note": "derate measured 2026-08-15: PV->DC-bus is 82.4% (159W PV -> 131W bus, battery at 0.0A). The old 0.90 was too generous at high PV and, paired with a 10W margin, too stingy at low PV."
  },

  "battery": {
    "reserveSoc": 15,
    "resumeSoc": 20,
    "hysteresis": {
      "enabled": false,
      "minSoc": 15,
      "hystSoc": 20
    }
  },

  "http": {
    "timeoutS": 5
  },

  "economics": {
    "importPriceEurPerKwh": 0.3159,
    "_note": "changes to 0.3142 on 2026-09-03, with a lower monthly fixed rate"
  },

  "dashboard": {
    "port": 8088,
    "bindHost": "0.0.0.0"
  },

  "collector": {
    "intervalS": 5,
    "timeoutS": 3,
    "commitEveryS": 60,
    "rawRetentionDays": 14,
    "maintenanceEveryS": 3600,
    "healthEveryS": 600,
    "dbPath": "/var/lib/zendure-log/zendure.db"
  },

  "verbose": 2
}
