# Real values: IPs, serial numbers, device passwords, host credentials.
# Anything matching *.local.* is secret by convention. Never commit.
# This repo is public.
config/config.local.json
config/*.local.*
**/*.local.md

# Generated script with config baked in
build/

# Raw device dumps (contain serial numbers, MACs, possibly SSIDs)
notes/*.json

# Local tooling state
.claude/settings.local.json
.DS_Store

# Collected data is never committed: the repo is public and the database runs
# to tens of megabytes. Archives live outside the working copy entirely
# (see tools/archive.py, default ~/zendure-archive); these patterns only guard
# against a stray copy landing here.
*.db
*.db-wal
*.db-shm
*.db.gz
data/
archive/
